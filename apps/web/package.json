{
  "name": "web",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev --port 3001",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && panda codegen",
    "check-types": "nuxt typecheck",
    "test": "vitest run --passWithNoTests",
    "deploy": "nuxt build && wrangler deploy --config .output/server/wrangler.json",
    "deploy:dry": "nuxt build && wrangler deploy --dry-run --config .output/server/wrangler.json"
  },
  "dependencies": {
    "@lumen/design": "workspace:*",
    "@lumen/schema": "workspace:*",
    "@nuxt/fonts": "1.0.1",
    "@nuxt/icon": "2.5.1",
    "nuxt": "npm:nuxt-nightly@5x",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@pandacss/dev": "^2.4.0",
    "@pandacss/preset-base": "2.4.0",
    "@pandacss/preset-panda": "2.4.0",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  }
}
