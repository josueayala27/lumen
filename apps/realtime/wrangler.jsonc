{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumen-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "LiveRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:3001",
    "REALTIME_TOKEN_SECRET": "dev-only-change-me"
  },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "lumen-realtime-staging",
      "workers_dev": false,
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "LiveRoom" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }],
      "vars": {
        "ALLOWED_ORIGINS": "https://app.staging.lumen.example,tauri://localhost"
      },
      "observability": { "enabled": true }
    },
    "production": {
      "name": "lumen-realtime",
      "workers_dev": false,
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "LiveRoom" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }],
      "vars": {
        "ALLOWED_ORIGINS": "https://app.lumen.example,tauri://localhost"
      },
      "observability": { "enabled": true }
    }
  }
}
