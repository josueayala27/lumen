{
  "name": "realtime",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 8788 --inspector-port 9401",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --minify",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lumen/auth-token": "workspace:*",
    "@lumen/schema": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250927.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
